{
  "name": "mtbo-sajten",
  "description": "Package for MTBO sajten mountainbikeorientering.se.",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier && npm run lint:css",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "lint:css": "stylelint \"**/*.{css,astro,mdoc}\"",
    "fix": "npm run fix:eslint && npm run fix:prettier && npm run fix:css",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "fix:css": "stylelint \"**/*.{css,astro,mdoc}\" --fix",
    "test": "npm run test:og && npm run test:meta && npm run test:hreflang && npm run test:jsonld && npm run test:maps && npm run test:groups && npm run test:sitemap && npm run test:links:internal && npm run test:headings && npm run test:orphans",
    "test:groups": "node tests/verify-event-groups.mjs",
    "test:maps": "node tests/verify-map-rendering.mjs",
    "test:og": "node tests/verify-og-images.mjs",
    "test:meta": "node tests/verify-meta-descriptions.mjs",
    "test:hreflang": "node tests/verify-hreflang.mjs",
    "test:jsonld": "node tests/verify-jsonld.mjs",
    "test:sitemap": "node tests/verify-sitemap.mjs",
    "test:links:internal": "node tests/verify-internal-links.mjs",
    "test:headings": "node tests/verify-headings.mjs",
    "test:orphans": "node tests/verify-orphans.mjs",
    "validate:links": "node tests/check-links.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "validate:images": "node scripts/validate-images.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.js",
    "import:events": "node scripts/import-events.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "stamp:hero": "node scripts/stamp-hero-logo.mjs",
    "fetch-youtube": "tsx scripts/fetch-youtube.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.1.5",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@astrolib/analytics": "^0.6.1",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/leaflet": "^1.9.22",
    "astro": "^7.4.12",
    "astro-embed": "^0.14.0",
    "astro-icon": "^1.2.0",
    "leaflet": "^1.9.4",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.6",
    "@distube/ytdl-core": "^5.2.1",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.46",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.5.0",
    "lint-staged": "^17.6.1",
    "png-to-ico": "^3.0.2",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
