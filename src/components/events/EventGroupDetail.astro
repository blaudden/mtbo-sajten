---
/**
 * Layout for multi-day camps and grouped weekend event packages.
 */
import type { EventGroup, ScraperEvent } from '~/types/events';
import { formatEventDateRange, formatRaceDate, resolveExternalUrl } from '~/utils/events';
import DisciplineBadge from './DisciplineBadge.astro';
import LeafletMap from '../LeafletMap.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  group: EventGroup;
  events: ScraperEvent[];
}

const { group, events } = Astro.props;
const dateRange = formatEventDateRange(group.start_date, group.end_date);

// Map markers across all events
const markers = events
  .flatMap((event) =>
    event.races.map((race) => {
      const title = `${race.name || event.name} - Arena`;
      if (race.position && race.position.lat && race.position.lng) {
        return {
          lat: race.position.lat,
          lng: race.position.lng,
          title,
          color: 'blue' as const,
          icon: 'start' as const,
        };
      }
      if (race.areas && race.areas.length > 0 && race.areas[0].lat && race.areas[0].lng) {
        return {
          lat: race.areas[0].lat,
          lng: race.areas[0].lng,
          title,
          color: 'blue' as const,
          icon: 'start' as const,
        };
      }
      return null;
    })
  )
  .filter((m): m is NonNullable<typeof m> => m !== null);

const hasMapData = markers.length > 0;
const markersString = JSON.stringify(markers);
---

<article class="event-group-detail max-w-4xl mx-auto">
  {/* Header Section */}
  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span
        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20"
      >
        Helgarrangemang / Weekendpaket
      </span>
      {
        group.name.toLowerCase().includes('svenska cupen') && (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300 border border-amber-300 dark:border-amber-700/50">
            Svenska Cupen MTBO
          </span>
        )
      }
    </div>

    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-3 font-heading"
    >
      {group.name}
    </h1>

    {group.subtitle && <p class="text-lg sm:text-xl text-muted dark:text-slate-300 mb-4">{group.subtitle}</p>}

    {/* Quick Info Grid */}
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-gray-700/60"
    >
      <div class="flex items-center gap-2.5">
        <Icon name="tabler:calendar" class="w-5 h-5 text-primary shrink-0" />
        <div>
          <span class="block text-xs text-muted dark:text-slate-400">Datum</span>
          <span class="text-sm font-semibold text-gray-900 dark:text-white">{dateRange}</span>
        </div>
      </div>

      {
        group.region && (
          <div class="flex items-center gap-2.5">
            <Icon name="tabler:map-pin" class="w-5 h-5 text-primary shrink-0" />
            <div>
              <span class="block text-xs text-muted dark:text-slate-400">Region</span>
              <span class="text-sm font-semibold text-gray-900 dark:text-white">{group.region}</span>
            </div>
          </div>
        )
      }

      {
        group.organisers && group.organisers.length > 0 && (
          <div class="flex items-center gap-2.5">
            <Icon name="tabler:users" class="w-5 h-5 text-primary shrink-0" />
            <div class="min-w-0">
              <span class="block text-xs text-muted dark:text-slate-400">Arrangör</span>
              <span class="text-sm font-semibold text-gray-900 dark:text-white truncate block">
                {group.organisers.join(', ')}
              </span>
            </div>
          </div>
        )
      }
    </div>
  </header>

  {/* Description */}
  {
    group.description && (
      <section class="mb-10 p-5 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-gray-700 shadow-xs">
        <h2 class="text-lg font-bold mb-2 text-gray-900 dark:text-white font-heading">Om arrangemanget</h2>
        <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line">
          {group.description}
        </p>
        {group.website && (
          <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700/60">
            <a
              href={group.website}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
            >
              <Icon name="tabler:external-link" class="w-4 h-4" />
              Officiell hemsida: {group.website.replace(/^https?:\/\//, '')}
            </a>
          </div>
        )}
      </section>
    )
  }

  {/* Included Events List */}
  <section class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white font-heading flex items-center gap-2">
        <Icon name="tabler:list-check" class="w-6 h-6 text-primary" />
        Ingående tävlingar i helgpaketet ({events.length} tävlingar)
      </h2>
    </div>

    <div class="space-y-4">
      {
        events.map((event, index) => {
          const externalUrl = resolveExternalUrl(event);
          const raceDate =
            event.races.length > 0
              ? formatRaceDate(event.races[0].datetimez, { includeYear: true, includeTime: false })
              : formatEventDateRange(event.start_time, event.end_time);
          const disciplines = [...new Set(event.races.map((r) => r.discipline))];

          return (
            <div class="p-5 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-gray-700 shadow-xs hover:border-primary/50 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-semibold px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-300">
                      Del {index + 1}
                    </span>
                    <span class="text-xs text-muted dark:text-slate-400 font-medium">{raceDate}</span>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                    <a href={`/events/${event.slug}`} class="hover:text-primary transition-colors">
                      {event.name}
                    </a>
                  </h3>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 self-start sm:self-auto">
                  {disciplines.map((d) => (
                    <DisciplineBadge discipline={d} />
                  ))}
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-gray-100 dark:border-gray-700/60 text-xs">
                <div class="text-muted dark:text-slate-400">
                  {event.organisers && event.organisers.length > 0 && (
                    <span>Arrangör: {event.organisers.map((o) => o.name).join(', ')}</span>
                  )}
                </div>

                <div class="flex items-center gap-3">
                  {externalUrl && (
                    <a
                      href={externalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-primary hover:underline font-medium"
                    >
                      <Icon name="tabler:external-link" class="w-3.5 h-3.5" />
                      Eventor
                    </a>
                  )}
                  <a
                    href={`/events/${event.slug}`}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary text-white hover:bg-primary/90 font-medium text-xs transition-colors"
                  >
                    Tävlingsinfo & program →
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {/* Map Section */}
  {
    hasMapData && (
      <section class="mb-10">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2 text-default font-heading">
          <Icon name="tabler:map" class="w-5 h-5 text-primary" />
          Arenor och tävlingsområden för helgen
        </h2>
        <div class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden shadow-sm">
          <LeafletMap markers={markersString} height="400px" zoom={11} />
        </div>
      </section>
    )
  }
</article>
