---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import type { SeedingOrder } from '~/types/cups';
import seedingDataRaw from '~/data/cups/seeding_order.json';

const activeSeeding = seedingDataRaw as SeedingOrder;
const activeYear = activeSeeding.year ?? new Date().getFullYear();
const prevYear = activeYear - 1;

const targetClasses = Object.keys(activeSeeding.classes);

const metadata = {
  title: `Seedningsordning Svenska Cupen MTBO ${activeYear}`,
  description: `Officiell seedningsordning för värdetävlingar (Nivå 1) i Svenska Cupen MTBO ${activeYear} beräknad enligt tävlingsreglerna.`,
};
---

<Layout metadata={metadata}>
  <!-- Page Hero Title -->
  <HeroText
    tagline="Svenska Cupen MTBO"
    title={`Seedningsordning ${activeYear}`}
    subtitle="Aktuell seedning för Svenska Cupen MTBO"
  />

  <!-- Rule Explanation Callout -->
  <WidgetWrapper containerClass="py-0 md:py-0 lg:py-0 max-w-5xl mx-auto mb-12">
    <div class="rounded-xl border border-primary-500/30 bg-primary-50/50 p-6 dark:bg-slate-800/80">
      <Headline
        title="Så säger reglerna"
        subtitle={`Seedning tillämpas vid Svenska Cupen MTBO och SM. Seedningsnumret fastställs som det lägsta värdet av cyklistens slutplacering i föregående års cup (${prevYear}) och aktuella ställning i årets cup (${activeYear}). Vid samma seedningsnummer gälls årets placering i första hand. Den seedade gruppen utgörs av de upp till 8 högst seedade cyklisterna som startar sist i klassen. Vid en enskild tävling begränsas den seedade gruppen i startfältet till maximalt 8 cyklister och högst 1/3 av tävlingens faktiska startfält.`}
        classes={{
          container: 'text-left mb-0 md:mb-0',
          title: 'text-xl md:text-2xl text-primary font-bold mb-2 font-heading',
          subtitle: 'text-base text-default dark:text-slate-300',
        }}
      />
    </div>
  </WidgetWrapper>

  <!-- Seeding Tables per Class -->
  <WidgetWrapper containerClass="py-0 md:py-0 lg:py-0 max-w-5xl mx-auto">
    {
      activeSeeding ? (
        <div class="space-y-12">
          {targetClasses.map((cls) => {
            const entries = activeSeeding.classes[cls] || [];
            return (
              <div
                id={cls}
                class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
              >
                <div class="mb-4 flex items-center justify-between">
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white font-heading">Klass {cls}</h2>
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-800 dark:bg-slate-800 dark:text-slate-200">
                    {entries.length} deltagare
                  </span>
                </div>

                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200 text-left text-sm dark:divide-slate-800">
                    <thead>
                      <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 dark:bg-slate-800/60 dark:text-slate-400">
                        <th class="px-4 py-3 w-16">Seed</th>
                        <th class="px-4 py-3">Namn</th>
                        <th class="px-4 py-3">Klubb</th>
                        <th class="px-4 py-3 text-center">Seedningsvärde</th>
                        <th class="px-4 py-3 text-center">Plac {activeYear}</th>
                        <th class="px-4 py-3 text-center">Plac {prevYear}</th>
                        <th class="px-4 py-3 text-right">Status</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-slate-800">
                      {entries.map((entry) => (
                        <tr class={entry.is_seeded ? 'bg-amber-50/60 dark:bg-amber-950/20' : ''}>
                          <td class="px-4 py-3 font-bold text-gray-900 dark:text-white">{entry.seed_rank}</td>
                          <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{entry.name}</td>
                          <td class="px-4 py-3 text-gray-600 dark:text-slate-400">{entry.club}</td>
                          <td class="px-4 py-3 text-center font-mono font-semibold text-primary-600 dark:text-primary-400">
                            {entry.seed_val}
                          </td>
                          <td class="px-4 py-3 text-center text-gray-600 dark:text-slate-400">
                            {entry.current_rank ?? '-'}
                          </td>
                          <td class="px-4 py-3 text-center text-gray-600 dark:text-slate-400">
                            {entry.previous_rank ?? '-'}
                          </td>
                          <td class="px-4 py-3 text-right">
                            {entry.is_seeded ? (
                              <span class="inline-flex items-center rounded-md bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                                Seedad grupp
                              </span>
                            ) : (
                              <span class="text-xs text-gray-400 dark:text-slate-500">Fri lottning</span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
          Ingen seedningsdata tillgänglig för {activeYear}.
        </div>
      )
    }
  </WidgetWrapper>

  <!-- Organiser Guide Widget -->
  <Steps2
    id="arrangor-guide"
    tagline="Arrangörsguide"
    title="Rekommendation för arrangörer"
    subtitle="Så tillämpar du seedning vid lottning i OLA, MeOS eller motsvarande tidtagningsprogram utan komplicerade inställningar"
    items={[
      {
        title: 'Identifiera de seedade cyklisterna',
        description:
          'Identifiera de seedade cyklisterna i klassen enligt tabellen ovan (märkta med <span class="inline-flex items-center rounded-md bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">Seedad grupp</span>).',
        icon: 'tabler:user-check',
      },
      {
        title: 'Slumpmässig lottning i tidtagningsprogrammet',
        description: 'Lotta hela klassen slumpmässigt i tidtagningsprogrammet som vanligt.',
        icon: 'tabler:dice',
      },
      {
        title: 'Byt starttider för de två grupperna',
        description:
          'Byt starttider så att de seedade cyklisterna placeras i klassens sista startplatser med bibehållen inbördes lottad ordning. De oseedade cyklisterna startar i de tidigare startplatserna, också med bibehållen inbördes lottad ordning.',
        icon: 'tabler:arrows-exchange',
      },
    ]}
  />
</Layout>
