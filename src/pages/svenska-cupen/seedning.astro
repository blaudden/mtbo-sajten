---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import type { SeedingOrder } from '~/types/cups';
import seedingDataRaw from '~/data/cups/seeding_order.json';

const activeSeeding = seedingDataRaw as SeedingOrder;
const activeYear = activeSeeding.year ?? new Date().getFullYear();
const prevYear = activeYear - 1;

const targetClasses = Object.keys(activeSeeding.classes);

const metadata = {
  title: `Seedningsordning Svenska Cupen MTBO ${activeYear}`,
  description: `Officiell seedningsordning för värdetävlingar (Nivå 1) i Svenska Cupen MTBO ${activeYear} beräknad enligt tävlingsreglerna.`,
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Seedningsordning {activeYear}
      </h1>
      <p class="mt-2 text-lg text-gray-600 dark:text-slate-400">
        Aktuell seedning för värdetävlingar i Svenska Cupen MTBO
      </p>
    </div>

    <!-- Rule Explanation Callout -->
    <div
      class="mb-8 rounded-lg border border-blue-200 bg-blue-50 p-4 text-blue-900 dark:border-blue-800/50 dark:bg-blue-950/40 dark:text-blue-200"
    >
      <h2 class="text-base font-semibold">Värdetävlingar (Nivå 1)</h2>
      <p class="mt-1 text-sm leading-relaxed">
        Seedning tillämpas vid värdetävlingar i Svenska Cupen MTBO enligt tävlingsreglerna. Seedningsnumret fastställs
        som det lägsta värdet av cyklistens slutplacering i föregående års cup ({prevYear}) och aktuella ställning i
        årets cup ({activeYear}). Vid samma seedningsnummer gälls årets placering i första hand. Den seedade gruppen
        utgörs av de upp till 8 högst seedade cyklisterna som startar sist i klassen. Vid en enskild tävling begränsas
        den seedade gruppen i startfältet till maximalt 8 cyklister och högst 1/3 av tävlingens faktiska startfält.
      </p>
    </div>

    {
      activeSeeding ? (
        <div class="space-y-12">
          {targetClasses.map((cls) => {
            const entries = activeSeeding.classes[cls] || [];
            return (
              <div
                id={cls}
                class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900"
              >
                <div class="mb-4 flex items-center justify-between">
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white">Klass {cls}</h2>
                  <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-800 dark:bg-slate-800 dark:text-slate-200">
                    {entries.length} deltagare
                  </span>
                </div>

                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200 text-left text-sm dark:divide-slate-800">
                    <thead>
                      <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 dark:bg-slate-800/60 dark:text-slate-400">
                        <th class="px-4 py-3 w-16">Seed</th>
                        <th class="px-4 py-3">Namn</th>
                        <th class="px-4 py-3">Klubb</th>
                        <th class="px-4 py-3 text-center">Seedningsvärde</th>
                        <th class="px-4 py-3 text-center">Plac {activeYear}</th>
                        <th class="px-4 py-3 text-center">Plac {prevYear}</th>
                        <th class="px-4 py-3 text-right">Status</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-slate-800">
                      {entries.map((entry) => (
                        <tr class={entry.is_seeded ? 'bg-amber-50/60 dark:bg-amber-950/20' : ''}>
                          <td class="px-4 py-3 font-bold text-gray-900 dark:text-white">{entry.seed_rank}</td>
                          <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{entry.name}</td>
                          <td class="px-4 py-3 text-gray-600 dark:text-slate-400">{entry.club}</td>
                          <td class="px-4 py-3 text-center font-mono font-semibold text-primary-600 dark:text-primary-400">
                            {entry.seed_val}
                          </td>
                          <td class="px-4 py-3 text-center text-gray-600 dark:text-slate-400">
                            {entry.current_rank ?? '-'}
                          </td>
                          <td class="px-4 py-3 text-center text-gray-600 dark:text-slate-400">
                            {entry.previous_rank ?? '-'}
                          </td>
                          <td class="px-4 py-3 text-right">
                            {entry.is_seeded ? (
                              <span class="inline-flex items-center rounded-md bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                                Seedad grupp
                              </span>
                            ) : (
                              <span class="text-xs text-gray-400 dark:text-slate-500">Fri lottning</span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
          Ingen seedningsdata tillgänglig för {activeYear}.
        </div>
      )
    }

    <!-- Advice for Organisers Card -->
    <div class="mt-12">
      <div class="rounded-xl border border-primary-500/30 bg-gray-50 p-6 shadow-sm dark:bg-slate-900">
        <div class="flex items-start space-x-4">
          <div class="rounded-lg bg-primary-500/10 p-3 text-primary-600 dark:text-primary-400">
            <Icon name="tabler:settings" class="h-6 w-6" />
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
              Rekommendation för arrangörer (Lottning i tidtagningsprogram)
            </h3>
            <p class="text-sm text-gray-600 dark:text-slate-300">
              För att tillämpa seedning i OLA, MeOS eller motsvarande tidtagningsprogram utan komplicerad
              regelkonfiguration:
            </p>
            <ol class="list-decimal space-y-1 pl-5 text-sm text-gray-600 dark:text-slate-300">
              <li>Lotta hela klassen slumpmässigt i tidtagningsprogrammet som vanligt.</li>
              <li>
                Identifiera de seedade cyklisterna enligt tabellen ovan (märkta med <strong
                  class="text-gray-900 dark:text-white">Seedad grupp</strong
                >). Vid tävlingar med färre startande begränsas antalet seedade cyklister till högst 1/3 av tävlingens
                startfält (dock maximalt 8).
              </li>
              <li>
                Sortera de seedade cyklisterna efter seedningsnummer (från sista seedningsnummer till högsta
                seedningsnummer 1).
              </li>
              <li>
                Byt starttider så att de seedade cyklisterna placeras i de sista startplatserna i klassen i ordning från
                sista seedad till högsta seedad sist, med bibehållen inbördes slumpmässig ordning för övriga cyklister.
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
